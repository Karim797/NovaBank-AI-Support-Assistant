# Copy to .env for local dev. NEVER commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Artifacts produced by the training pipeline
MODEL_PATH=models/intent_clf_v1.joblib
INDEX_PATH=models/kb_index_v1.joblib

# Routing
# Leave unset to use the threshold baked into the model artifact (currently 0.45).
# CONFIDENCE_THRESHOLD=0.45
RETRIEVAL_TOP_K=4
RETRIEVAL_MIN_SCORE=0.15

# LLM: "extractive" runs fully offline (deterministic, no key).
#      "anthropic" calls the real API and requires ANTHROPIC_API_KEY.
LLM_PROVIDER=extractive
LLM_MODEL=claude-sonnet-4-5
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2
ANTHROPIC_API_KEY=

# Feedback store
FEEDBACK_DB_URL=sqlite:///feedback.db

# API protection (leave empty to disable auth locally)
API_KEY=
RATE_LIMIT_PER_MINUTE=60
MAX_QUESTION_CHARS=500
